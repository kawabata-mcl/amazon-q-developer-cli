{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ./ui",
    "beforeBuildCommand": "npm run build --prefix ./ui",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../ui/out"
  },
  "productName": "Amazon Q Desktop",
  "version": "1.15.0",
  "identifier": "com.amazon.codewhisperer",
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["*"],
          "permissions": [
            "core:default",
            "core:event:default",
            "core:event:allow-listen",
            "core:window:default",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-set-always-on-top"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Amazon Q Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Light"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "src-tauri/icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Amazon Q Developer Desktop Application",
    "longDescription": "macOS GUI application for Amazon Q Developer CLI. Provides intuitive interface to access Amazon Q Developer functionality.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {}
}